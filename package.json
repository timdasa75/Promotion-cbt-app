{
  "name": "promotion-cbt-app",
  "version": "1.0.0",
  "description": "An interactive CBT practice application for Nigerian civil service promotion exams at the directorate level.",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test tests/smoke.spec.js --reporter=line --max-failures=1",
    "test:smoke:full": "playwright test tests/smoke.spec.js",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "audit:topic-banks": "node scripts/audit_topic_bank_contamination.mjs",
    "audit:topic-banks:strict": "node scripts/audit_topic_bank_contamination.mjs --fail-on-findings",
    "audit:topic-banks:ci": "node scripts/audit_topic_bank_contamination.mjs --fail-on-findings --allow-missing-topic-files",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "antigravity:init": "antigravity init",
    "design:export": "antigravity export-design",
    "antigravity:verify": "antigravity verify",
    "antigravity:run": "antigravity run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timdasa75/Promotion-cbt-app.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/timdasa75/Promotion-cbt-app/issues"
  },
  "homepage": "https://github.com/timdasa75/Promotion-cbt-app#readme",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "vite": "^8.0.1",
    "vite-plugin-static-copy": "^3.3.0",
    "wrangler": "^4.86.0"
  },
  "overrides": {
    "undici": "^7.24.0",
    "ws": "^8.20.1",
    "anymatch": {
      "picomatch": "^2.3.2"
    },
    "readdirp": {
      "picomatch": "^2.3.2"
    }
  }
}
