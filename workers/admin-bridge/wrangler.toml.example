name = "promotion-cbt-admin-bridge"
main = "worker.js"
compatibility_date = "2026-03-08"

# Configure your own route/domain in Cloudflare dashboard.

[vars]
FIREBASE_PROJECT_ID = "promotioncbt-app"
# Required in production: exact comma-separated browser origins allowed to
# call the worker. Wildcards are rejected; missing origins fail closed.
# ALLOWED_ORIGINS = "https://timdasa75.github.io"
# Optional quota billing project for x-goog-user-project header (omit unless needed).
# FIREBASE_QUOTA_PROJECT_ID = "promotioncbt-app"
# Required comma-separated admin emails for backend admin access.
# ADMIN_EMAILS = "admin@example.com"
# Optional: set to false to skip Firebase Auth disabled-flag sync and only patch profile status.
# SYNC_AUTH_DISABLED = "true"
# Feedback notification emails (resolve + reply) are suspended by default to
# conserve the D1 free tier (row reads, not email sends, were the exhausted
# resource — see the 2026-09-11 quota outage). Users see admin responses in the
# app instead: the profile page's "My Feedback" card shows replies with an unread
# badge. Set to "true" on Workers Paid to also email users on resolve/reply.
# FEEDBACK_EMAILS_ENABLED = "true"
# Soft email verification (default): new users sign in immediately after
# registering and unverified users can still log in — a lost verification
# email never locks anyone out, and unverified logins get a cooldown-limited
# verification-email reminder. Set to "true" to restore the old hard
# verify-before-login gate once email delivery is dependable again.
# REQUIRE_EMAIL_VERIFICATION = "true"
# Phase-2 hybrid auth rollout knobs (not live until auth endpoints are added):
# CLOUDFLARE_AUTH_ISSUER = "https://promotion-cbt-auth.<your-subdomain>.workers.dev"

# Secrets required (set via `wrangler secret put`):
# - FIREBASE_API_KEY
# - GCP_SERVICE_ACCOUNT_EMAIL
# - GCP_SERVICE_ACCOUNT_PRIVATE_KEY
# - FLW_SECRET_KEY
# - FLW_WEBHOOK_SECRET_HASH
# Optional hybrid-auth secret for later:
# - TURNSTILE_SECRET_KEY
# Optional flag: set AUTH_PASSWORD_RECOVERY_SENDER="true" only once a real
# email sender (Resend/SendGrid/Workers Email) backs the recovery route.
# Until then the /auth/password/request route honestly tells users to contact
# an administrator instead of claiming instructions were emailed.
#
# WhatsApp self-service password recovery (free: users message first, which
# opens Meta's 24-hour service window; the Worker's reply is non-template and
# costs nothing). Requires a Meta WhatsApp Business app + webhook subscription:
#   WHATSAPP_TOKEN             - permanent System User access token (Graph API)
#   WHATSAPP_PHONE_NUMBER_ID   - the business phone number's ID in the app
#   WHATSAPP_APP_SECRET        - app secret (verifies X-Hub-Signature-256)
#   WHATSAPP_VERIFY_TOKEN      - any random string; also pasted into Meta's
#                                webhook subscription form
#   PUBLIC_BASE_URL            - e.g. "https://timdasa75.github.io" (used to
#                                build reset links; GitHub Pages serves the
#                                app under /<repo>, so the link includes it)
# Webhook callback URL: https://<worker-host>/whatsapp/webhook
# Also set whatsappBusinessNumber in config/runtime-auth.js to show the
# login-screen button.
# STATUS: ON HOLD (2026-09-18) — no WhatsApp Business account yet. The flow is
# fully built and unit-tested but dormant: keep these unset and do NOT deploy
# the /whatsapp/webhook route until the Meta app exists.
# TOKEN and APP_SECRET are sensitive: set them with `wrangler secret put`
# (WHATSAPP_TOKEN, WHATSAPP_APP_SECRET); the rest may live in [vars].
# WHATSAPP_TOKEN = ""
# WHATSAPP_PHONE_NUMBER_ID = ""
# WHATSAPP_APP_SECRET = ""
# WHATSAPP_VERIFY_TOKEN = ""
# PUBLIC_BASE_URL = ""

# Optional D1 binding for the future hybrid auth rollout:
# [[d1_databases]]
# binding = "AUTH_DB"
# database_name = "promotion-cbt-auth"
# database_id = "replace-with-your-d1-database-id"
